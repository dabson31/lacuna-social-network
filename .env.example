# Copy to .env for local development (`go run ./src/server/cmd/server`).
# Docker does NOT read this file; those values are set in docker-compose.yml.

# "development" or "production". development = readable text logs + non-Secure
# cookies (needed over plain-http localhost). production = JSON logs + Secure cookies.
APP_ENV=development

# Port the server listens on (1-65535).
PORT=8080

# Where the SQLite file is created. The parent dir is made automatically.
DB_PATH=src/server/data/social.db

# Folder of .up.sql / .down.sql migrations, read at startup. Must be a directory.
MIGRATIONS_PATH=src/server/pkg/db/migrations/sqlite

# Where uploaded avatars/images are written and served from.
UPLOAD_DIR=src/server/data/uploads

# How long a session stays valid. Any Go duration: 168h = 7 days.
SESSION_TTL=168h

# The frontend origin allowed to call the API with credentials (CORS).
ALLOWED_ORIGIN=http://localhost:3000
